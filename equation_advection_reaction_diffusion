import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation
import sys
# CREATION DU MAILLAGE ET PARAMETRES DU PROBLEME

L = 1.0   #longuer du domaine
Nx = 100    # Nombre de points
dx = L / Nx    # Pas spatial
T = 1.0    # Temps final
Nt = 80000       # Nombre de pas de temps
dt = T / Nt   # Pas de temps


D = 3  # Diffusion  avec Nx= 100 et Nt = 80000 D pas plus grand que 4

def c(x):        # Advection
    return x #toujours positive et on a une variations qui depend de x

def c_pos(x):
    return 0.5 * (c(x) + np.abs(c(x)))

def c_neg(x):
    return 0.5 * (np.abs(c(x)) - c(x))


K = 20   # Capacité max de la population
r = -3
B = 40.0  # Majorant u^2 <= B u




# CONDITION INITIALE
x = np.linspace(0, L, Nx+1)

def u0(x):
    return np.exp(-100*(x-0.3)**2)

u_old = u0(x)

# VERIFICATION CFL
# cmax sur le maillage
c_vals = np.array([c(xi) for xi in x])          
cmax = np.max(np.abs(c_vals))

CFL_adv  = cmax * dt / dx                       # doit être <= 1 (upwind explicite)
CFL_diff = D * dt / dx**2                       # doit être <= 0.5 (diffusion explicite)

ok_adv  = (CFL_adv  <= 1.0 + 1e-12)             # petite tolérance numérique
ok_diff = (CFL_diff <= 0.5 + 1e-12)

print("CFL_adv  = {CFL_adv}  <= 1")
print("CFL_diff = {CFL_diff} <= 0.5")

if not ok_adv:
    print("CFL advection nok")

if not ok_diff:
    print("Stabilité diffusion nok")

if not (ok_adv and ok_diff):
    print("STOP")
    sys.exit()
# CREATION ANIMATION
fig, ax = plt.subplots()
line, = ax.plot(x, u_old)
ax.set_ylim(-0.2, 1.5)
ax.set_xlabel("x")
ax.set_ylabel("u(x,t)")

# RESOLUTION DU SCHEMA (EULER EXPLICITE)

def un_pas(frame): #frame pour print anim
    global u_old

    u_new = u_old.copy()

    # Euler explicite sur i=1,...,Nx-1 

    for i in range(1, Nx):
        ci_pos = c_pos(x[i])
        ci_neg = c_neg(x[i])
    
        lam = (1
                   + dt * r
                   - dt * r * B / K
                   - 2 * dt * D / dx**2
                   + dt * (ci_pos + ci_neg) / dx)
    
        lam_plus = dt * D / dx**2 - dt * ci_neg / dx
        lam_moins = dt * D / dx**2 - dt * ci_pos / dx
    
        u_new[i] = (lam * u_old[i]
                        + lam_plus * u_old[i+1]
                        + lam_moins * u_old[i-1])
    # Dirichlet
    u_new[0]  = 0.0
    u_new[-1] = 0.0
    #u_new[0] = u_new[1]
    #u_new[-1] = u_new[-2]

    # sécurité anti-NaN
    if not np.all(np.isfinite(u_new)):
        print("NaN/Inf détecté à t =", frame*dt)
        u_new = np.nan_to_num(u_new, nan=0.0, posinf=0.0, neginf=0.0)

    u_old = u_new

    line.set_ydata(u_new)
    ax.set_title(f"t = {frame*dt:.4f}")
    return line,

ani = FuncAnimation(fig, un_pas, frames=Nt, interval=20)
plt.show()
